generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Church {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  logo              String?
  cardLogo          String?
  address           String?
  phone             String?
  email             String?
  site              String?
  denomination      String?
  serviceHours      String?
  // Transmissão ao vivo: o YouTube faz o trabalho pesado (e aguenta qualquer
  // audiência de graça); o app só embute o player e avisa a igreja.
  liveUrl           String?
  liveTitle         String?
  liveActive        Boolean            @default(false)
  liveStartedAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  members           Member[]
  cells             Cell[]
  events            Event[]
  transactions      Transaction[]
  campaigns         Campaign[]
  communications    Communication[]
  prayers           Prayer[]
  worshipServices   WorshipService[]
  serviceSchedules  ServiceSchedule[]
  payables          Payable[]
  birthdayGreetings BirthdayGreeting[]
  visitors          Visitor[]
  attendances       Attendance[]
  teams             MinistryTeam[]
  schoolClasses     SchoolClass[]
  arenaSeasons      ArenaSeason[]
  arenaThemePolls   ArenaThemePoll[]
  arenaFlashes      ArenaFlash[]
  arenaMissions     ArenaMission[]
  courses           Course[]
}

// Escola Bíblica: turma, professor e sala.
model SchoolClass {
  id          String            @id @default(cuid())
  churchId    String
  church      Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  // O professor costuma ser membro; `teacherName` cobre quem não é cadastrado.
  teacherId   String?
  teacherName String?
  room        String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  enrollments ClassEnrollment[]
  lessons     ClassLesson[]

  @@index([churchId, active])
}

// Matrícula do aluno na turma.
model ClassEnrollment {
  id        String      @id @default(cuid())
  churchId  String
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId  String
  createdAt DateTime    @default(now())

  @@unique([classId, memberId])
  @@index([memberId])
}

// Uma aula da turma num dia — é a folha da caderneta.
// @@unique(classId, day): a mesma turma não tem duas aulas no mesmo domingo.
model ClassLesson {
  id          String            @id @default(cuid())
  churchId    String
  classId     String
  class       SchoolClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  day         String
  topic       String?
  note        String?
  createdAt   DateTime          @default(now())
  attendances ClassAttendance[]

  @@unique([classId, day])
  @@index([churchId, day])
}

// Chamada: quem esteve na aula.
model ClassAttendance {
  id       String      @id @default(cuid())
  churchId String
  lessonId String
  lesson   ClassLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  memberId String

  @@unique([lessonId, memberId])
  @@index([memberId])
}

// Equipe que serve na igreja: louvor, recepção, som, kids, diaconia.
model MinistryTeam {
  id        String         @id @default(cuid())
  churchId  String
  church    Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  members   TeamMember[]
  slots     ScheduleSlot[]

  @@index([churchId, active])
}

// Quem faz parte da equipe (e a função habitual: vocal, guitarra, portaria).
model TeamMember {
  id       String       @id @default(cuid())
  churchId String
  teamId   String
  team     MinistryTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberId String
  role     String?

  @@unique([teamId, memberId])
  @@index([memberId])
}

enum ScheduleStatus {
  PENDING
  CONFIRMED
  DECLINED
}

// Uma escalação: fulano serve na equipe X, no dia Y.
// O @@unique impede escalar a mesma pessoa duas vezes no mesmo dia e equipe.
model ScheduleSlot {
  id          String         @id @default(cuid())
  churchId    String
  teamId      String
  team        MinistryTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberId    String
  date        DateTime
  role        String?
  status      ScheduleStatus @default(PENDING)
  note        String?
  createdAt   DateTime       @default(now())
  respondedAt DateTime?

  @@unique([teamId, memberId, date])
  @@index([churchId, date])
  @@index([memberId, date])
}

// Presença no culto. Uma por membro por dia (@@unique): duas pessoas do mesmo
// aparelho, dois toques ou recarregar a página não inflam a contagem.
//
// `worshipId` guarda O CULTO quando ele existe cadastrado; quando a presença
// vem do horário fixo da agenda, fica nulo e vale o dia.
model Attendance {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  memberId  String
  worshipId String?
  day       String
  // Quem registrou: nulo = o próprio membro pelo app; preenchido = alguém do
  // painel marcou na mão (quem não usa o aplicativo).
  markedBy  String?
  createdAt DateTime @default(now())

  @@unique([memberId, day])
  @@index([churchId, day])
  @@index([memberId])
}

// Visitante que se cadastrou sozinho lendo o QR code no culto.
//
// Fica SEPARADO de Member de propósito: visitante ainda não é membro, e
// misturar os dois sujaria a membresia, o ranking e os relatórios da igreja.
// Quando a liderança confirma, a conversão cria o Member de verdade e guarda
// o vínculo em `memberId`.
model Visitor {
  id            String            @id @default(cuid())
  churchId      String
  church        Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  birthDate     DateTime?
  city          String?
  // "Como você chegou até nós?" — mostra o que realmente traz gente.
  howFound      String?
  // Nome de quem convidou (texto livre: pode ser alguém que nem é membro).
  invitedBy     String?
  prayerRequest String?
  wantsVisit    Boolean           @default(false)
  status        VisitorStatus     @default(NEW)
  // Preenchido quando o visitante vira membro.
  memberId      String?
  firstVisitAt  DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  followUps     VisitorFollowUp[]

  @@index([churchId, status])
  @@index([churchId, createdAt])
}

enum VisitorStatus {
  NEW
  CONTACTED
  RETURNED
  MEMBER
  ARCHIVED
}

// Histórico do acompanhamento: ligou, visitou, convidou para a célula.
model VisitorFollowUp {
  id        String   @id @default(cuid())
  churchId  String
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  note      String
  userId    String?
  createdAt DateTime @default(now())

  @@index([visitorId])
}

// Conta parcelada (ex.: ar-condicionado em 10x). Cadastrar NÃO mexe no saldo:
// cada parcela só vira despesa (Transaction) quando é paga — regime de caixa,
// que é como a igreja enxerga o dinheiro. Ver PayableInstallment.transactionId.
model Payable {
  id           String               @id @default(cuid())
  churchId     String
  church       Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  description  String
  creditor     String?
  category     String
  installments Int
  note         String?
  createdBy    String?
  createdAt    DateTime             @default(now())
  items        PayableInstallment[]

  @@index([churchId])
}

model PayableInstallment {
  id            String    @id @default(cuid())
  payableId     String
  payable       Payable   @relation(fields: [payableId], references: [id], onDelete: Cascade)
  churchId      String
  number        Int
  dueDate       DateTime
  amount        Decimal   @db.Decimal(12, 2)
  paidAt        DateTime?
  // Quanto saiu de fato (juros de atraso ou desconto mudam o valor).
  paidAmount    Decimal?  @db.Decimal(12, 2)
  // Despesa gerada no pagamento — desfazer o pagamento apaga esse lançamento.
  transactionId String?

  @@unique([payableId, number])
  @@index([churchId, dueDate])
  @@index([churchId, paidAt])
}

// Inscrição do membro num evento com vagas limitadas. O `@@unique` é o que
// impede a mesma pessoa de ocupar duas vagas (dois cliques, dois aparelhos).
model EventRegistration {
  id        String   @id @default(cuid())
  churchId  String
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  createdAt DateTime @default(now())

  @@unique([eventId, memberId])
  @@index([churchId, eventId])
  @@index([memberId])
}

// Recado de aniversário que um membro deixa para outro. O `year` faz o
// carinho se repetir todo ano: em 2027 a igreja parabeniza de novo, sem
// apagar o que foi escrito em 2026.
model BirthdayGreeting {
  id        String   @id @default(cuid())
  churchId  String
  // Vínculo real com a igreja: se a igreja sair, os recados (que são
  // mensagens pessoais) saem junto, sem deixar órfão no banco.
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  // Quem faz aniversário.
  memberId  String
  // Quem deixou o recado.
  authorId  String
  year      Int
  message   String?
  createdAt DateTime @default(now())

  @@unique([memberId, authorId, year])
  @@index([churchId, memberId, year])
}

// Agenda FIXA da igreja: "toda terça, quinta e domingo tem culto no mesmo
// horário". Não gera registros de culto — é o quadro de horários que o membro
// vê no portal, sem depender de alguém cadastrar cada semana.
model ServiceSchedule {
  id       String  @id @default(cuid())
  churchId String
  church   Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  weekday  Int // 0 = domingo … 6 = sábado
  time     String // "19:30"
  name     String // "Culto de ensino"
  note     String? // "Somente jovens", "Ceia no 1º domingo"
  active   Boolean @default(true)
  order    Int     @default(0)

  @@index([churchId, active])
}

model User {
  id           String   @id @default(cuid())
  churchId     String
  church       Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(MEMBER)
  gender       Gender?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([churchId])
}

enum Gender {
  MALE
  FEMALE
}

enum PortalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model DevotionalPrayer {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  day       String
  createdAt DateTime @default(now())

  @@unique([memberId, day])
  @@index([churchId, day])
}

model Devotional {
  id         String   @id @default(cuid())
  churchId   String
  date       String
  title      String?
  verseRef   String?
  verseText  String?
  reflection String
  songTitle  String?
  songUrl    String?
  image      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([churchId, date])
  @@index([churchId])
}

model DevotionalCompletion {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  day       String
  createdAt DateTime @default(now())

  @@unique([memberId, day])
  @@index([churchId, day])
  @@index([memberId])
}

model DevotionalNote {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  day       String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, day])
  @@index([memberId])
}

model DevotionalReaction {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  day       String
  type      String
  createdAt DateTime @default(now())

  @@unique([memberId, day])
  @@index([churchId, day])
}

model DevotionalPlan {
  id          String              @id @default(cuid())
  churchId    String
  title       String
  description String?
  cover       String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  days        DevotionalPlanDay[]

  @@index([churchId])
}

model DevotionalPlanDay {
  id         String         @id @default(cuid())
  planId     String
  plan       DevotionalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber  Int
  title      String?
  verseRef   String?
  verseText  String?
  reflection String

  @@unique([planId, dayNumber])
  @@index([planId])
}

// Inscrição de notificação de UM aparelho. É de um membro do portal
// (memberId) OU de uma conta do painel (userId) — nunca dos dois.
model PushSubscription {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String?
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([churchId])
  @@index([memberId])
  @@index([userId])
}

// Trilha temática do devocional que o membro está seguindo (7 dias). Os temas
// e o conteúdo moram no app; aqui guardamos só QUAL trilha e em que dia ele
// está. `lastDay` garante que a trilha avança no máximo uma vez por dia.
model MemberDevotionalTrail {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String   @unique
  trailId   String
  position  Int      @default(0)
  lastDay   String?
  startedAt DateTime @default(now())

  @@index([churchId])
}

model DevotionalPlanProgress {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  planId    String
  dayNumber Int
  createdAt DateTime @default(now())

  @@unique([memberId, planId, dayNumber])
  @@index([memberId, planId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PASTOR
  SECRETARY
  TREASURER
  LEADER
  MEMBER
}

model Member {
  id                  String                 @id @default(cuid())
  churchId            String
  church              Church                 @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name                String
  email               String?
  phone               String?
  cpf                 String?
  gender              Gender?
  birthDate           DateTime?
  baptismDate         DateTime?
  address             String?
  city                String?
  rg                  String?
  maritalStatus       String?
  profession          String?
  photo               String?
  passwordHash        String?
  portalStatus        PortalStatus           @default(NONE)
  // Quais notificações o membro quer receber. NULL = recebe tudo (padrão).
  // Formato: { "worship": true, "events": false, ... } — ver push.service.ts.
  notifyPrefs         Json?
  status              MemberStatus           @default(ACTIVE)
  role                MemberRole?
  cellId              String?
  cell                Cell?                  @relation(fields: [cellId], references: [id], onDelete: SetNull)
  joinedAt            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  arenaAnswers        ArenaAnswer[]
  arenaOpens          ArenaQuestionOpen[]
  arenaDuelsFeitos    ArenaDuel[]            @relation("desafiante")
  arenaDuelsRecebidos ArenaDuel[]            @relation("desafiado")
  arenaTurnos         ArenaRoundTurn[]
  arenaVotos          ArenaThemeVote[]
  cursosInscrito      CourseEnrollment[]     @relation("cursoAluno")
  cursosComoParceiro  CourseEnrollment[]     @relation("cursoParceiro")
  cursosProgresso     CourseProgress[]       @relation("cursoProgresso")
  resetRequests       PasswordResetRequest[]

  @@index([churchId])
  @@index([cellId])
}

// Pedido de "esqueci minha senha" feito na tela de entrada do portal.
// A secretaria resolve no painel gerando uma senha temporária (que marca
// os pedidos pendentes do membro como DONE).
model PasswordResetRequest {
  id         String    @id @default(cuid())
  churchId   String
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status     String    @default("PENDING") // PENDING | DONE
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([churchId, status])
  @@index([memberId, status])
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  VISITOR
  TRANSFERRED
  DECEASED
}

enum MemberRole {
  DEACON
  ELDER
  EVANGELIST
  PASTOR
  WORKER
  MEMBER
}

model Cell {
  id           String        @id @default(cuid())
  churchId     String
  church       Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name         String
  leaderId     String?
  coLeaderId   String?
  dayOfWeek    String?
  time         String?
  address      String?
  neighborhood String?
  capacity     Int?
  active       Boolean       @default(true)
  members      Member[]
  meetings     CellMeeting[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([churchId])
}

model CellMeeting {
  id        String   @id @default(cuid())
  cellId    String
  cell      Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  date      DateTime
  theme     String?
  attendees Int?
  notes     String?
  createdAt DateTime @default(now())

  @@index([cellId])
}

model Transaction {
  id          String          @id @default(cuid())
  churchId    String
  church      Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  type        TransactionType
  category    String
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  createdBy   String?
  createdAt   DateTime        @default(now())

  @@index([churchId])
  @@index([date])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Event {
  id             String              @id @default(cuid())
  churchId       String
  church         Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  date           DateTime
  endDate        DateTime?
  location       String?
  capacity       Int?
  type           String?
  photo          String?
  // Quando a foto mudou pela última vez. Serve para dois fins: saber se existe
  // foto SEM carregar o base64 (que é pesado) nas listagens, e versionar a URL
  // pública (?v=) para o cache do navegador expirar quando a imagem trocar.
  photoUpdatedAt DateTime?
  createdAt      DateTime            @default(now())
  registrations  EventRegistration[]

  @@index([churchId])
}

model Campaign {
  id          String         @id @default(cuid())
  churchId    String
  church      Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String
  status      CampaignStatus @default(ACTIVE)
  goal        Decimal?       @db.Decimal(12, 2)
  current     Decimal?       @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())

  @@index([churchId])
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Communication {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      String   @default("NOTICE")
  authorId  String?
  createdAt DateTime @default(now())

  @@index([churchId])
}

model Prayer {
  id            String               @id @default(cuid())
  churchId      String
  church        Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  memberId      String?
  title         String
  description   String?
  status        PrayerStatus         @default(ACTIVE)
  visibility    String               @default("PUBLIC")
  createdAt     DateTime             @default(now())
  intercessions PrayerIntercession[]

  @@index([churchId])
}

// "Estou orando por você": um membro se junta ao pedido de outro. Um por
// membro por pedido — o toque de novo desfaz.
model PrayerIntercession {
  id        String   @id @default(cuid())
  churchId  String
  prayerId  String
  prayer    Prayer   @relation(fields: [prayerId], references: [id], onDelete: Cascade)
  memberId  String
  createdAt DateTime @default(now())

  @@unique([prayerId, memberId])
  @@index([churchId])
}

enum PrayerStatus {
  ACTIVE
  ANSWERED
  ARCHIVED
}

model WorshipService {
  id           String               @id @default(cuid())
  churchId     String
  church       Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title        String
  date         DateTime
  theme        String?
  bibleRef     String?
  notes        String?
  status       WorshipStatus        @default(PLANNED)
  items        WorshipItem[]
  participants WorshipParticipant[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([churchId])
  @@index([date])
}

model WorshipItem {
  id          String         @id @default(cuid())
  serviceId   String
  service     WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  order       Int            @default(0)
  title       String
  responsible String?
  durationMin Int?
  notes       String?

  @@index([serviceId])
}

model WorshipParticipant {
  id        String         @id @default(cuid())
  serviceId String
  service   WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  memberId  String?
  name      String
  role      String
  notes     String?

  @@index([serviceId])
}

enum WorshipStatus {
  PLANNED
  DONE
  CANCELED
}

// Arena Bíblica: resposta de um membro a uma pergunta do desafio diário.
// Pontos são calculados NO SERVIDOR (a alternativa correta nunca vai ao
// cliente). Única por (memberId, day, questionId): uma tentativa por pergunta.
/// Quando o servidor ENTREGOU a pergunta ao membro.
///
/// O cronômetro da Arena não pode viver no celular: bastaria pausar o
/// JavaScript para responder com calma. Aqui fica a hora real da abertura, e
/// é contra ela que a resposta é conferida. Reabrir a pergunta NÃO reinicia a
/// contagem — senão fechar e voltar ao app daria tempo infinito.
/// Trava de "isto roda uma vez só".
///
/// Existe para avisos e correções pontuais que precisam acontecer no deploy e
/// nunca mais: a chave é o id, então a segunda tentativa de inserir falha e o
/// trabalho é pulado — inclusive se a API reiniciar ou rodar em duas réplicas.
model SystemFlag {
  key       String   @id
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Arena: temporadas, duelos, desafio surpresa e missão coletiva.
//
// O que NÃO virou tabela, de propósito: sequência de dias, conquistas e os
// destaques da semana. Tudo isso se calcula a partir de ArenaAnswer, que já
// guarda quem respondeu o quê e quando. Tabela de troféu só teria como ganho
// evitar uma soma barata, em troca de dois lugares para a verdade morar.
// ---------------------------------------------------------------------------

/// O tema da semana. Uma linha por ciclo (domingo a sábado) por igreja.
// ---------------------------------------------------------------------------
// Cursos do app (batismo, noivos, e o que mais a igreja quiser).
//
// NÃO reaproveita a Escola Bíblica de propósito: lá a lição é uma folha de
// chamada por domingo, marcada pelo professor; aqui é um texto numerado, lido
// e marcado pelo próprio aluno. Forçar as duas na mesma estrutura deixaria as
// duas confusas.
// ---------------------------------------------------------------------------

model Course {
  id          String             @id @default(cuid())
  churchId    String
  church      Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title       String
  description String?
  kind        String             @default("OTHER") // BAPTISM | MARRIAGE | OTHER
  /// Curso de casal: a inscrição vale para os dois noivos.
  couple      Boolean            @default(false)
  /// O app prepara, não substitui o pastor: a conclusão exige a conversa.
  needsPastor Boolean            @default(true)
  published   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  lessons     CourseLesson[]
  enrollments CourseEnrollment[]

  @@index([churchId, published])
}

model CourseLesson {
  id        String           @id @default(cuid())
  churchId  String
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  content   String
  /// Passagens que sustentam a lição; abrem na Bíblia do próprio app.
  bibleRefs String[]
  question  String?
  createdAt DateTime         @default(now())
  progress  CourseProgress[]

  @@unique([courseId, position])
  @@index([churchId])
}

model CourseEnrollment {
  id           String           @id @default(cuid())
  churchId     String
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member           @relation("cursoAluno", fields: [memberId], references: [id], onDelete: Cascade)
  /// O outro noivo. Só nos cursos de casal.
  partnerId    String?
  partner      Member?          @relation("cursoParceiro", fields: [partnerId], references: [id], onDelete: SetNull)
  completedAt  DateTime?
  /// Marcado pela liderança depois da conversa presencial.
  pastorTalkAt DateTime?
  /// Data do batismo, quando houver. Preenche o baptismDate do membro.
  baptizedAt   DateTime?
  createdAt    DateTime         @default(now())
  progress     CourseProgress[]

  @@unique([courseId, memberId])
  @@index([churchId, courseId])
}

model CourseProgress {
  id           String           @id @default(cuid())
  churchId     String
  enrollmentId String
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// Quem concluiu. Num curso de casal os dois marcam, e é assim que o pastor
  /// enxerga o caso de um fazer e o outro não.
  memberId     String
  member       Member           @relation("cursoProgresso", fields: [memberId], references: [id], onDelete: Cascade)
  /// O que a pessoa escreveu. Material de aconselhamento: só a liderança lê.
  reflection   String?
  doneAt       DateTime         @default(now())

  @@unique([enrollmentId, lessonId, memberId])
  @@index([churchId])
}

model ArenaSeason {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  startDay  String // domingo, "AAAA-MM-DD"
  endDay    String // sábado
  theme     String // identificador do tema (ver themes.ts)
  createdAt DateTime @default(now())

  @@unique([churchId, startDay])
  @@index([churchId])
}

/// A votação que decide o tema da PRÓXIMA semana.
model ArenaThemePoll {
  id        String           @id @default(cuid())
  churchId  String
  church    Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  startDay  String // ciclo em que a votação corre
  endDay    String
  options   String[] // temas em disputa
  closed    Boolean          @default(false)
  winner    String? // preenchido ao apurar
  createdAt DateTime         @default(now())
  votes     ArenaThemeVote[]

  @@unique([churchId, startDay])
  @@index([churchId])
}

model ArenaThemeVote {
  id        String         @id @default(cuid())
  churchId  String
  pollId    String
  poll      ArenaThemePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  theme     String
  createdAt DateTime       @default(now())

  // Um voto por pessoa por votação.
  @@unique([pollId, memberId])
  @@index([churchId])
}

/// Duelo 1x1. As MESMAS perguntas para os dois, para a disputa ser justa.
model ArenaDuel {
  id           String           @id @default(cuid())
  churchId     String
  challengerId String
  challenger   Member           @relation("desafiante", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId   String? // só existe depois que alguém aceita o convite
  opponent     Member?          @relation("desafiado", fields: [opponentId], references: [id], onDelete: Cascade)
  questionIds  String[]
  /// Token do link. É por ele que o convite viaja no WhatsApp, então precisa
  /// ser imprevisível: quem adivinhasse entraria no duelo dos outros.
  token        String           @unique
  rematchOfId  String?
  /// Convite direto (revanche): quem foi convidado precisa ACEITAR. Convite
  /// por link nao tem convidado ate alguem abrir — ai abrir E aceitar.
  acceptedAt   DateTime?
  declinedAt   DateTime?
  /// Um convite, um push. Guardas de "ja avisei" para o aviso nao repetir
  /// quando a API reinicia ou roda em duas replicas.
  inviteSentAt DateTime?
  resultSentAt DateTime?
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  turns        ArenaRoundTurn[]

  @@index([churchId])
  @@index([challengerId])
  @@index([opponentId])
}

/// Uma pergunta entregue dentro de um duelo ou de um desafio surpresa.
///
/// Serve aos dois porque o mecanismo é o mesmo: o servidor marca a hora da
/// entrega (openedAt) e confere a resposta contra ela — a mesma defesa da
/// Arena do dia, que não pode viver só no relógio do navegador.
model ArenaRoundTurn {
  id         String      @id @default(cuid())
  churchId   String
  kind       String // "DUEL" | "FLASH"
  duelId     String?
  duel       ArenaDuel?  @relation(fields: [duelId], references: [id], onDelete: Cascade)
  flashId    String?
  flash      ArenaFlash? @relation(fields: [flashId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  questionId String
  openedAt   DateTime    @default(now())
  choice     Int?
  correct    Boolean?
  answeredAt DateTime?

  @@unique([duelId, memberId, questionId])
  @@unique([flashId, memberId, questionId])
  @@index([churchId])
}

/// Desafio surpresa: abre de repente e fecha em poucos minutos.
model ArenaFlash {
  id         String           @id @default(cuid())
  churchId   String
  church     Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  startsAt   DateTime // quando libera (dá para agendar)
  windowMin  Int              @default(10) // minutos para ENTRAR
  questions  Int              @default(5)
  bonus      Int              @default(5) // pontos por acerto
  notifiedAt DateTime? // push já disparado
  createdAt  DateTime         @default(now())
  turns      ArenaRoundTurn[]

  @@index([churchId, startsAt])
}

/// Meta da igreja inteira na semana. O progresso sai de ArenaAnswer.
model ArenaMission {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title     String
  kind      String // "CORRECT" (acertos) | "ROUNDS" (rodadas concluídas)
  target    Int
  startDay  String
  endDay    String
  reward    String?
  createdAt DateTime @default(now())

  @@index([churchId, startDay])
}

model ArenaQuestionOpen {
  id         String   @id @default(cuid())
  churchId   String
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  day        String // "AAAA-MM-DD" no fuso de Brasília
  questionId String
  openedAt   DateTime @default(now())

  @@unique([memberId, day, questionId])
  @@index([churchId, day])
}

model ArenaAnswer {
  id         String   @id @default(cuid())
  churchId   String
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  day        String // "AAAA-MM-DD" no fuso de Brasília
  questionId String
  choice     Int
  correct    Boolean
  points     Int
  // Respondeu depois do cronômetro fechar: vale 0 mesmo se a escolha estava
  // certa. Guardado para a resposta ser honesta na tela ("acertou, mas...").
  timedOut   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([memberId, day, questionId])
  @@index([churchId, day])
  @@index([churchId, memberId])
}
