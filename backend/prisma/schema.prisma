generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Church {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  logo           String?
  cardLogo       String?
  address        String?
  phone          String?
  email          String?
  site           String?
  denomination   String?
  serviceHours   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  members        Member[]
  cells          Cell[]
  events         Event[]
  transactions   Transaction[]
  campaigns      Campaign[]
  communications Communication[]
  prayers        Prayer[]
  worshipServices WorshipService[]
  serviceSchedules ServiceSchedule[]
}

// Agenda FIXA da igreja: "toda terça, quinta e domingo tem culto no mesmo
// horário". Não gera registros de culto — é o quadro de horários que o membro
// vê no portal, sem depender de alguém cadastrar cada semana.
model ServiceSchedule {
  id       String  @id @default(cuid())
  churchId String
  church   Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  weekday  Int // 0 = domingo … 6 = sábado
  time     String // "19:30"
  name     String // "Culto de ensino"
  note     String? // "Somente jovens", "Ceia no 1º domingo"
  active   Boolean @default(true)
  order    Int     @default(0)

  @@index([churchId, active])
}

model User {
  id           String   @id @default(cuid())
  churchId     String
  church       Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(MEMBER)
  gender       Gender?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([churchId])
}

enum Gender {
  MALE
  FEMALE
}

enum PortalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model DevotionalPrayer {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  day       String
  createdAt DateTime @default(now())

  @@unique([memberId, day])
  @@index([churchId, day])
}

model Devotional {
  id         String   @id @default(cuid())
  churchId   String
  date       String
  title      String?
  verseRef   String?
  verseText  String?
  reflection String
  songTitle  String?
  songUrl    String?
  image      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([churchId, date])
  @@index([churchId])
}

model DevotionalCompletion {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  day       String
  createdAt DateTime @default(now())

  @@unique([memberId, day])
  @@index([churchId, day])
  @@index([memberId])
}

model DevotionalNote {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  day       String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, day])
  @@index([memberId])
}

model DevotionalReaction {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  day       String
  type      String
  createdAt DateTime @default(now())

  @@unique([memberId, day])
  @@index([churchId, day])
}

model DevotionalPlan {
  id          String              @id @default(cuid())
  churchId    String
  title       String
  description String?
  cover       String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  days        DevotionalPlanDay[]

  @@index([churchId])
}

model DevotionalPlanDay {
  id         String         @id @default(cuid())
  planId     String
  plan       DevotionalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber  Int
  title      String?
  verseRef   String?
  verseText  String?
  reflection String

  @@unique([planId, dayNumber])
  @@index([planId])
}

// Inscrição de notificação de UM aparelho. É de um membro do portal
// (memberId) OU de uma conta do painel (userId) — nunca dos dois.
model PushSubscription {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String?
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([churchId])
  @@index([memberId])
  @@index([userId])
}

// Trilha temática do devocional que o membro está seguindo (7 dias). Os temas
// e o conteúdo moram no app; aqui guardamos só QUAL trilha e em que dia ele
// está. `lastDay` garante que a trilha avança no máximo uma vez por dia.
model MemberDevotionalTrail {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String   @unique
  trailId   String
  position  Int      @default(0)
  lastDay   String?
  startedAt DateTime @default(now())

  @@index([churchId])
}

model DevotionalPlanProgress {
  id        String   @id @default(cuid())
  churchId  String
  memberId  String
  planId    String
  dayNumber Int
  createdAt DateTime @default(now())

  @@unique([memberId, planId, dayNumber])
  @@index([memberId, planId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PASTOR
  SECRETARY
  TREASURER
  LEADER
  MEMBER
}

model Member {
  id        String       @id @default(cuid())
  churchId  String
  church    Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  cpf       String?
  gender    Gender?
  birthDate DateTime?
  baptismDate DateTime?
  address   String?
  city      String?
  rg            String?
  maritalStatus String?
  profession    String?
  photo     String?
  passwordHash String?
  portalStatus PortalStatus @default(NONE)
  // Quais notificações o membro quer receber. NULL = recebe tudo (padrão).
  // Formato: { "worship": true, "events": false, ... } — ver push.service.ts.
  notifyPrefs  Json?
  status    MemberStatus @default(ACTIVE)
  role      MemberRole?
  cellId    String?
  cell      Cell?        @relation(fields: [cellId], references: [id], onDelete: SetNull)
  joinedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  arenaAnswers ArenaAnswer[]
  resetRequests PasswordResetRequest[]

  @@index([churchId])
  @@index([cellId])
}

// Pedido de "esqueci minha senha" feito na tela de entrada do portal.
// A secretaria resolve no painel gerando uma senha temporária (que marca
// os pedidos pendentes do membro como DONE).
model PasswordResetRequest {
  id         String    @id @default(cuid())
  churchId   String
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status     String    @default("PENDING") // PENDING | DONE
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([churchId, status])
  @@index([memberId, status])
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  VISITOR
  TRANSFERRED
  DECEASED
}

enum MemberRole {
  DEACON
  ELDER
  EVANGELIST
  PASTOR
  WORKER
  MEMBER
}

model Cell {
  id           String        @id @default(cuid())
  churchId     String
  church       Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name         String
  leaderId     String?
  coLeaderId   String?
  dayOfWeek    String?
  time         String?
  address      String?
  neighborhood String?
  capacity     Int?
  active       Boolean       @default(true)
  members      Member[]
  meetings     CellMeeting[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([churchId])
}

model CellMeeting {
  id        String   @id @default(cuid())
  cellId    String
  cell      Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  date      DateTime
  theme     String?
  attendees Int?
  notes     String?
  createdAt DateTime @default(now())

  @@index([cellId])
}

model Transaction {
  id          String          @id @default(cuid())
  churchId    String
  church      Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  type        TransactionType
  category    String
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  createdBy   String?
  createdAt   DateTime        @default(now())

  @@index([churchId])
  @@index([date])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Event {
  id          String    @id @default(cuid())
  churchId    String
  church      Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  description String?
  date        DateTime
  endDate     DateTime?
  location    String?
  capacity    Int?
  type        String?
  photo       String?
  // Quando a foto mudou pela última vez. Serve para dois fins: saber se existe
  // foto SEM carregar o base64 (que é pesado) nas listagens, e versionar a URL
  // pública (?v=) para o cache do navegador expirar quando a imagem trocar.
  photoUpdatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([churchId])
}

model Campaign {
  id          String         @id @default(cuid())
  churchId    String
  church      Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String
  status      CampaignStatus @default(ACTIVE)
  goal        Decimal?       @db.Decimal(12, 2)
  current     Decimal?       @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())

  @@index([churchId])
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Communication {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      String   @default("NOTICE")
  authorId  String?
  createdAt DateTime @default(now())

  @@index([churchId])
}

model Prayer {
  id          String       @id @default(cuid())
  churchId    String
  church      Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  memberId    String?
  title       String
  description String?
  status      PrayerStatus @default(ACTIVE)
  visibility  String       @default("PUBLIC")
  createdAt   DateTime     @default(now())
  intercessions PrayerIntercession[]

  @@index([churchId])
}

// "Estou orando por você": um membro se junta ao pedido de outro. Um por
// membro por pedido — o toque de novo desfaz.
model PrayerIntercession {
  id        String   @id @default(cuid())
  churchId  String
  prayerId  String
  prayer    Prayer   @relation(fields: [prayerId], references: [id], onDelete: Cascade)
  memberId  String
  createdAt DateTime @default(now())

  @@unique([prayerId, memberId])
  @@index([churchId])
}

enum PrayerStatus {
  ACTIVE
  ANSWERED
  ARCHIVED
}

model WorshipService {
  id           String               @id @default(cuid())
  churchId     String
  church       Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title        String
  date         DateTime
  theme        String?
  bibleRef     String?
  notes        String?
  status       WorshipStatus        @default(PLANNED)
  items        WorshipItem[]
  participants WorshipParticipant[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([churchId])
  @@index([date])
}

model WorshipItem {
  id          String         @id @default(cuid())
  serviceId   String
  service     WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  order       Int            @default(0)
  title       String
  responsible String?
  durationMin Int?
  notes       String?

  @@index([serviceId])
}

model WorshipParticipant {
  id        String         @id @default(cuid())
  serviceId String
  service   WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  memberId  String?
  name      String
  role      String
  notes     String?

  @@index([serviceId])
}

enum WorshipStatus {
  PLANNED
  DONE
  CANCELED
}

// Arena Bíblica: resposta de um membro a uma pergunta do desafio diário.
// Pontos são calculados NO SERVIDOR (a alternativa correta nunca vai ao
// cliente). Única por (memberId, day, questionId): uma tentativa por pergunta.
model ArenaAnswer {
  id         String   @id @default(cuid())
  churchId   String
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  day        String   // "AAAA-MM-DD" no fuso de Brasília
  questionId String
  choice     Int
  correct    Boolean
  points     Int
  createdAt  DateTime @default(now())

  @@unique([memberId, day, questionId])
  @@index([churchId, day])
  @@index([churchId, memberId])
}
